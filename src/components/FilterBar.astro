---
interface Props {
  initialCount: number;
  resourceTypeLabels?: Record<string, string>;
  accessLabels?: Record<string, string>;
  showSearch?: boolean;
  searchPlaceholder?: string;
  searchId?: string;
}

const {
  initialCount,
  resourceTypeLabels = {},
  accessLabels = {},
  showSearch = false,
  searchPlaceholder = 'Search resources...',
  searchId = 'scoped-search',
} = Astro.props;
---

<div class="filter-bar">
  {showSearch && (
    <div class="filter-group search-group">
      <label>Search</label>
      <div class="scoped-search">
        <span class="scoped-search-icon">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </span>
        <input type="text" id={searchId} placeholder={searchPlaceholder} />
      </div>
    </div>
  )}
  <div class="filter-group">
    <label>Access</label>
    <select id="filter-access">
      <option value="all">All Access</option>
      <option value="free">Free</option>
      <option value="paid">Paid</option>
      <option value="freemium">Freemium</option>
      <option value="open_access">Open Access</option>
    </select>
  </div>
  <div class="filter-group">
    <label>Type</label>
    <select id="filter-type">
      <option value="all">All Types</option>
      {Object.entries(resourceTypeLabels).map(([k, v]) => <option value={k}>{v}</option>)}
    </select>
  </div>
  <div class="filter-group">
    <label>Verified</label>
    <select id="filter-verified">
      <option value="all">All Status</option>
      <option value="verified">Verified</option>
    </select>
  </div>
  <div class="filter-group sort-group">
    <label>Sort</label>
    <select id="sort-select">
      <option value="relevance">Relevance</option>
      <option value="rating">Rating</option>
      <option value="alphabetical">Alphabetical</option>
    </select>
  </div>
  <span class="result-count" id="result-count">{initialCount} resources</span>
</div>

<script define:vars={{ searchId }} is:inline>
  function initializeResourceFilters() {
  const filterAccess = document.getElementById('filter-access');
  const filterType = document.getElementById('filter-type');
  const filterVerified = document.getElementById('filter-verified');
  const sortSelect = document.getElementById('sort-select');
  const resultCount = document.getElementById('result-count');
  const searchInput = searchId ? document.getElementById(searchId) : null;
  const rows = document.querySelectorAll('.resource-row');

  let debounceTimer;

  function applyFilters() {
    const access = filterAccess.value;
    const type = filterType.value;
    const verified = filterVerified.value;
    const sort = sortSelect.value;
    const q = searchInput?.value.toLowerCase().trim() || '';
    let count = 0;

    rows.forEach(row => {
      const matchSearch = q === '' ||
        row.dataset.title?.includes(q) ||
        row.dataset.desc?.includes(q) ||
        row.dataset.domain?.includes(q) ||
        row.dataset.tags?.includes(q) ||
        row.dataset.sub?.includes(q);
      const matchAccess = access === 'all' || row.dataset.access === access;
      const matchType = type === 'all' || row.dataset.type === type;
      const matchVerified = verified === 'all' || (verified === 'verified' && row.dataset.verified === 'true');
      const show = matchSearch && matchAccess && matchType && matchVerified;
      row.style.display = show ? '' : 'none';
      if (show) count++;
    });

    resultCount.textContent = `${count} resources`;

    // Hide empty subsection headings and top-level science sections.
    document.querySelectorAll('.resource-subsection').forEach(subsection => {
      const visible = subsection.querySelectorAll('.resource-row:not([style*="none"])').length;
      subsection.style.display = visible > 0 ? '' : 'none';
    });
    document.querySelectorAll('.resource-section').forEach(sec => {
      const visible = sec.querySelectorAll('.resource-row:not([style*="none"])').length;
      sec.style.display = visible > 0 ? '' : 'none';
    });

    // Sort rows without pulling them out of their science/subdiscipline group.
    document.querySelectorAll('.resource-section').forEach(sec => {
      const subsections = Array.from(sec.querySelectorAll(':scope > .resource-subsection'));
      const groups = subsections.length > 0 ? subsections : [sec];
      groups.forEach(group => {
        const groupRows = Array.from(group.querySelectorAll(':scope > .resource-row'));
        if (sort === 'alphabetical') {
          groupRows.sort((a, b) => a.dataset.title.localeCompare(b.dataset.title));
        } else {
          groupRows.sort((a, b) => parseFloat(b.dataset.rating) - parseFloat(a.dataset.rating));
        }
        groupRows.forEach(row => group.appendChild(row));
      });
    });
  }

  function debouncedApply() {
    clearTimeout(debounceTimer);
    debounceTimer = window.setTimeout(applyFilters, 150);
  }

  [filterAccess, filterType, filterVerified, sortSelect].forEach(el => el.addEventListener('change', applyFilters));
  searchInput?.addEventListener('input', debouncedApply);

  // Directory search is linkable so the landing-page search can hand off to
  // this single, existing filtering implementation. Unknown parameters are
  // ignored to preserve referral and analytics URLs.
  const params = new URLSearchParams(window.location.search);
  if (searchInput && params.has('q')) searchInput.value = params.get('q') || '';
  if (params.has('access') && [...filterAccess.options].some(option => option.value === params.get('access'))) {
    filterAccess.value = params.get('access');
  }
  if (params.has('type') && [...filterType.options].some(option => option.value === params.get('type'))) {
    filterType.value = params.get('type');
  }
  if (params.has('verified') && [...filterVerified.options].some(option => option.value === params.get('verified'))) {
    filterVerified.value = params.get('verified');
  }
  if (params.has('sort') && [...sortSelect.options].some(option => option.value === params.get('sort'))) {
    sortSelect.value = params.get('sort');
  }
  if ([...params.keys()].some(key => ['q', 'access', 'type', 'verified', 'sort'].includes(key))) applyFilters();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeResourceFilters, { once: true });
  } else {
    initializeResourceFilters();
  }
</script>
