---
import DirectoryLayout from '../../../layouts/DirectoryLayout.astro';
import { loadResources, loadStatusMap, buildTree, SCIENCES, RESOURCE_TYPE_LABELS, ACCESS_LABELS, slugify } from '../../../lib/data';

export function getStaticPaths() {
  const resources = loadResources();
  const paths: any[] = [];
  for (const sci of SCIENCES) {
    const sciResources = resources.filter(r => r.science === sci.slug);
    const subdisciplines = new Set(sciResources.map(r => r.subdiscipline));
    for (const subName of subdisciplines) {
      const subSlug = slugify(subName);
      const subResources = sciResources.filter(r => r.subdiscipline === subName);
      paths.push({
        params: { science: sci.slug, subdiscipline: subSlug },
        props: { science: sci, subdiscipline: subName, subResources },
      });
    }
  }
  return paths;
}

const { science, subdiscipline, subResources } = Astro.props;
const allResources = loadResources();
const statusMap = loadStatusMap();
const tree = buildTree(allResources);
const subSlug = slugify(subdiscipline);

const sorted = [...subResources].sort((a, b) => b.rating - a.rating);
const verifiedCount = subResources.filter(r => r.isVerified).length;
---

<DirectoryLayout
  title={`${subdiscipline} — ${science.name}`}
  description={`${subdiscipline} resources within ${science.name}. Browse ${subResources.length} curated links including portals, tools, databases, journals, and educational materials.`}
  breadcrumb={[{ label: 'PhysicURL', href: '/' }, { label: science.name, href: `/${science.slug}.html` }, { label: subdiscipline }]}
  tree={tree}
  currentPath={`/${science.slug}/${subSlug}`}
  totalCount={subResources.length}
>
  <div class="filter-bar">
    <div class="filter-group">
      <label>Access</label>
      <select id="filter-access">
        <option value="all">All Access</option>
        <option value="free">Free</option>
        <option value="paid">Paid</option>
        <option value="freemium">Freemium</option>
      </select>
    </div>
    <div class="filter-group">
      <label>Type</label>
      <select id="filter-type">
        <option value="all">All Types</option>
        {Object.entries(RESOURCE_TYPE_LABELS).map(([k, v]) => <option value={k}>{v}</option>)}
      </select>
    </div>
    <div class="filter-group">
      <label>Verified</label>
      <select id="filter-verified">
        <option value="all">All Status</option>
        <option value="verified">Verified</option>
      </select>
    </div>
    <div class="filter-group sort-group">
      <label>Sort</label>
      <select id="sort-select">
        <option value="relevance">Relevance</option>
        <option value="rating">Rating</option>
        <option value="alphabetical">Alphabetical</option>
      </select>
    </div>
    <span class="result-count" id="result-count">{subResources.length} resources</span>
  </div>

  <div class="resource-list" id="resource-list">
    <div class="resource-section">
      <div class="resource-section-title">{subdiscipline} ({subResources.length})</div>
      {sorted.map(r => {
        const status = statusMap[r.url];
        const isUnderReview = !!status;
        return (
          <div class={`resource-row ${isUnderReview ? 'under-review' : ''}`} data-access={r.access} data-type={r.resourceType} data-verified={r.isVerified} data-rating={r.rating}>
            <div class="resource-title-line">
              <a href={r.url} target="_blank" rel="noopener" class={`resource-title ${isUnderReview ? 'disabled-link' : ''}`}>{r.title}</a>
              {r.isVerified && <span class="verified-badge">✓ Verified</span>}
              {isUnderReview && <span class="review-badge" title={status?.details || 'Under review'}>⚠ Under Review</span>}
              {r.isAffiliate && <span class="affiliate-badge">Affiliate</span>}
              <span class="resource-domain">{r.domain}</span>
            </div>
            <div class="resource-description">{r.description}</div>
            <div class="resource-tags">
              {r.tags.map(tag => <span class="resource-tag">#{tag}</span>)}
            </div>
            <div class="resource-meta">
              <span class={`access-badge-${r.access}`}>{ACCESS_LABELS[r.access] || r.access}</span>
              <span class="rating">★ {r.rating}</span>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</DirectoryLayout>

<script is:inline>
  const filterAccess = document.getElementById('filter-access');
  const filterType = document.getElementById('filter-type');
  const filterVerified = document.getElementById('filter-verified');
  const sortSelect = document.getElementById('sort-select');
  const resultCount = document.getElementById('result-count');
  const rows = document.querySelectorAll('.resource-row');

  function applyFilters() {
    const access = filterAccess.value;
    const type = filterType.value;
    const verified = filterVerified.value;
    const sort = sortSelect.value;
    let count = 0;
    rows.forEach(row => {
      const show = (access === 'all' || row.dataset.access === access) &&
                   (type === 'all' || row.dataset.type === type) &&
                   (verified === 'all' || (verified === 'verified' && row.dataset.verified === 'true'));
      row.style.display = show ? '' : 'none';
      if (show) count++;
    });
    resultCount.textContent = `${count} resources`;
    if (sort === 'rating' || sort === 'relevance') {
      const sortedRows = Array.from(rows).sort((a, b) => parseFloat(b.dataset.rating) - parseFloat(a.dataset.rating));
      sortedRows.forEach(r => document.querySelector('.resource-section').appendChild(r));
    } else if (sort === 'alphabetical') {
      const sortedRows = Array.from(rows).sort((a, b) => a.querySelector('.resource-title').textContent.localeCompare(b.querySelector('.resource-title').textContent));
      sortedRows.forEach(r => document.querySelector('.resource-section').appendChild(r));
    }
  }
  [filterAccess, filterType, filterVerified, sortSelect].forEach(el => el.addEventListener('change', applyFilters));
</script>
