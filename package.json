{
  "name": "physicurl",
  "type": "module",
  "version": "2.0.1",
  "engines": {
    "node": ">=22.20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx,.astro",
    "test": "node --test src/lib/__tests__/*.test.ts src/lib/__tests__/*.test.mjs src/lib/resource-import/__tests__/*.test.ts src/lib/url-health/__tests__/*.test.ts src/lib/resource-health/__tests__/*.test.ts",
    "test:mvp": "node --test src/lib/__tests__/*.test.ts src/lib/__tests__/*.test.mjs src/lib/resource-import/__tests__/*.test.ts",
    "test:url-health": "node --test src/lib/url-health/__tests__/*.test.ts",
    "test:resource-health": "node --test src/lib/resource-health/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-data.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.1",
    "@astrojs/tailwind": "^5.1.5",
    "astro": "^5.4.0",
    "axios": "^1.20.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "nanoid": "^5.0.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.7.0",
    "sass": "^1.104.0",
    "typescript": "^5.7.0"
  }
}
